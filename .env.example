# Скопируйте в .env.local и заполните только выбранный маршрут.
# Настоящие ключи и .env.local НЕ входят в сдачу.
# API: совместимый с Chat Completions endpoint. Другой SDK тоже допустим.
# Локально: запущенный Ollama с уже загруженными моделями.
CHAT_BACKEND=api
CHAT_MODEL=
CHAT_BASE_URL=
CHAT_API_KEY=
# Пример для совместимого API. Некоторым моделям нужен max_completion_tokens.
# Замените параметр по документации ВАШЕЙ модели; не копируйте reasoning-настройки другого провайдера.
CHAT_OPTIONS={"max_tokens":2048}

# Embeddings настраиваются независимо от генерации.
EMBEDDING_BACKEND=ollama
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# Используется только в ветках ollama. Ключ платного API им не нужен.
OLLAMA_BASE_URL=http://localhost:11434
TOP_K=4
# Защита от случайно огромного prompt. Символы НЕ равны токенам.
MAX_CONTEXT_CHARS=32000
